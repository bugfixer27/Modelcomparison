<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.scoreboard.run</string>
  <key>ProgramArguments</key>
  <array><string>__ROOT__/scripts/run_hourly.sh</string></array>
  <key>WorkingDirectory</key><string>__ROOT__</string>
  <!-- StartInterval (not StartCalendarInterval): launchd coalesces missed intervals into ONE run after wake,
       which is exactly the catch-up behaviour a frequently-asleep laptop needs. -->
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__ROOT__/store/logs/launchd.out</string>
  <key>StandardErrorPath</key><string>__ROOT__/store/logs/launchd.err</string>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>5</integer>
</dict>
</plist>
